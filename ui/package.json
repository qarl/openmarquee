{
  "name": "openmarquee-ui",
  "version": "0.0.0",
  "private": true,
  "description": "OpenMarquee browser UI",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "esbuild src/main.js src/welcome.js --bundle --outdir=dist --servedir=. --watch",
    "build": "esbuild src/main.js src/welcome.js --bundle --minify --outdir=dist",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "esbuild": "^0.21.0",
    "jsdom": "^29.0.2",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "sortablejs": "^1.15.7"
  }
}
