# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Jimmy local artifacts (defensive — code repo shouldn't carry these)
.Jimmy/
AGENTS.md

# Node / web
# (no trailing slash — matches the dir AND the symlink-to-external-deps form)
node_modules
dist/
build/
.cache/
.parcel-cache/

# Local runtime content / playlist / preview scratch
# (dev.sh + test runs write these at the cwd defaults)
openmarquee-content/
openmarquee-playlist.json
openmarquee-schedules.json
openmarquee-settings.json
openmarquee-seeded.json

# rclone-fuse mount sometimes leaves these stub files behind — they
# aren't ours.
.fuse_hidden*

# Seeded assets:
# - curated backgrounds + demo videos ARE tracked (shipped with the repo)
# - any OTHER large operator drop (legacy demo.mp4, etc.) is NOT tracked
backend/openmarquee/seed_assets/*
!backend/openmarquee/seed_assets/.gitkeep
!backend/openmarquee/seed_assets/README.md
!backend/openmarquee/seed_assets/backgrounds/
!backend/openmarquee/seed_assets/backgrounds/**
!backend/openmarquee/seed_assets/videos/
!backend/openmarquee/seed_assets/videos/**
# Re-ignore AppleDouble + .DS_Store inside the un-ignored seed_assets
# subtree -- the `**` negations above un-ignore EVERYTHING under those
# paths, which would silently leak macOS metadata (`._brick-wall.png`
# etc.) into `git add -A`. Negation-then-re-ignore closes the hole.
backend/openmarquee/seed_assets/**/._*
backend/openmarquee/seed_assets/**/.DS_Store

# Playwright
playwright-report/
test-results/
.playwright/

# vitest cache
.vite/

# Noto Color Emoji is fetched at build time by scripts/download-emoji-
# font.sh — too heavy (~10 MB) to live in git, but bundled at runtime
# alongside the in-repo @font-face fonts (Inter, Reenie Beanie, ...)
# so editor preview and device renderer use the same color glyphs.
ui/fonts/noto-color-emoji.ttf

# Editor
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# Env / secrets
.env
.env.*
!.env.example

# Local dev state
*.log

# rclone mount leaves partial-upload files around when a write gets
# interrupted; they're ghost files (listable but not unlinkable). Ignore
# so they don't pollute `git status`.
*.partial
