# pi-gen.config — environment variables sourced by pi-gen's build.sh.
#
# Drop this in at the top of a pi-gen checkout (rename to `config`) before
# running `./build.sh`. See ../README.md for the full invocation.
#
# Pi-gen reference: https://github.com/RPi-Distro/pi-gen
# All keys here override pi-gen's defaults; anything not set falls back to
# the defaults baked into pi-gen itself.

# --- Image identity ---

# Image filename will be <date>-<IMG_NAME>-<RELEASE>-<TARGET_ARCH>-lite.img.
# Keep the hyphenated form so the date prefix from pi-gen reads cleanly.
IMG_NAME='openmarquee'

# Released image filename suffix (appears in /etc/rpi-issue).
# Keeps a paper trail for "which image was this device flashed from?"
DEPLOY_COMPRESSION='xz'
COMPRESSION_LEVEL=6

# --- Pi OS release line ---

# trixie = Debian 13. As of mid-2026, Pi OS trixie is the supported
# leading edge for Pi Zero 2 W. Older bookworm is fine if you must
# downgrade, but our argon2id tune (Pi argon2 memo) was measured on
# trixie's argon2-cffi.
RELEASE='trixie'

# arm64 — Pi Zero 2 W's BCM2710A1 is ARMv8 64-bit. Pi 4/5 also 64-bit.
# Note: the original Pi Zero (ARMv6) is NOT supported.
TARGET_ARCH='arm64'

# --- First-boot identity (cloud-init overrides this at first boot) ---

# Pre-cloud-init hostname. Cloud-init (B.2) replaces this with
# openmarquee-<4-char-hex> on first boot for mDNS uniqueness.
HOSTNAME='openmarquee'

# pi-gen creates this user with passwordless sudo. SSH is locked down
# at the cloud-init layer (B.2) -- key-only, no password auth.
FIRST_USER_NAME='openmarquee'
# Password is irrelevant for remote access: cloud-init disables password
# auth before SSH is opened to the world. Set to a literal here to satisfy
# pi-gen. NB: between flash and the first cloud-init run there's a brief
# window where this literal IS the device password on the local serial
# console -- but SSH is locked off at that point, so exploitation requires
# physical access. Operator never types this; they SSH via Tailscale + key.
FIRST_USER_PASS='change-me-at-first-boot'
DISABLE_FIRST_BOOT_USER_RENAME=1

# --- Locale / keyboard ---
LOCALE_DEFAULT='en_US.UTF-8'
KEYBOARD_KEYMAP='us'
KEYBOARD_LAYOUT='English (US)'
TIMEZONE_DEFAULT='Etc/UTC'

# --- WiFi (operator-supplied at provisioning time) ---
# Empty by default; the wifi-prefill flow on first boot reads
# wpa_supplicant.conf if present and folds it into settings.json. If
# the operator pre-populates these via cloud-init user-data, the
# device joins their station network on first boot.
WPA_ESSID=''
WPA_PASSWORD=''
WPA_COUNTRY='US'

# --- Pi-gen control flags ---

# Skip the desktop/X11 stages -- openMarquee runs framebuffer-direct
# via vc4-fkms-v3d. Stage3 + Stage4 + Stage5 give you LXDE / RPi-only
# extras / Recommended Software respectively. None apply to us.
#
# Note: pi-gen marks stages as "skipped" via the presence of a `SKIP`
# file inside that stage dir. The build-image.sh wrapper (B.6) touches
# those files; this config is documentation-only for the skip set.
# Stages to skip: stage3, stage4, stage5.
