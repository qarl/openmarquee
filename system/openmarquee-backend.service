[Unit]
Description=openMarquee backend (FastAPI + playback loop)
Documentation=https://github.com/qarl/openmarquee

# Wait until the network stack is up. openmarquee-ap0.service creates
# the virtual `ap0` interface; hostapd.service hosts the AP on it;
# dnsmasq.service runs DHCP/DNS on it. All three should be settled
# before we bind to port 80 (uvicorn listens on 0.0.0.0 so it catches
# both ap0 and any station-mode wlan0 association — that's the remote-
# management surface Tailscale later reaches).
After=network-online.target openmarquee-ap0.service hostapd.service dnsmasq.service
Wants=network-online.target

[Service]
Type=simple
User=openmarquee
Group=openmarquee
WorkingDirectory=/opt/openmarquee/backend

# Content + playlist + schedule live under /var per Linux FHS (variable
# state). The systemd unit sets explicit paths so the app doesn't depend on
# cwd-relative defaults.
Environment="OPENMARQUEE_CONTENT_ROOT=/var/openmarquee/content"
Environment="OPENMARQUEE_UI_DIR=/opt/openmarquee/ui"
Environment="OPENMARQUEE_PLAYLIST_PATH=/var/openmarquee/playlist.json"
Environment="OPENMARQUEE_SCHEDULE_PATH=/var/openmarquee/schedules.json"
Environment="OPENMARQUEE_SETTINGS_PATH=/var/openmarquee/settings.json"
Environment="OPENMARQUEE_SEED_MARKER_PATH=/var/openmarquee/seeded.json"
Environment="OPENMARQUEE_DEV_PREVIEW_PATH=/var/openmarquee/preview.png"

# Production: strip the /dev tooling (preview page, manual play endpoint)
# from the HTTP surface. The gate is read by app.py at startup.
Environment="OPENMARQUEE_DISABLE_DEV=1"

# Use the multi-plane DRM/KMS renderer when output_mode=hdmi (per
# settings.json). Stress-tests the new rendering system end-to-end:
# bg + statics on the primary plane, animated layers on overlays,
# scanout via vc4 HVS instead of per-tick PIL composite. Falls back
# to MockRenderer at startup if DRM init fails (see app.py lifespan).
Environment="OPENMARQUEE_RENDERER=auto"

# Shader transitions disabled by default on Pi Zero 2 W. The
# 2026-05-06 stress test surfaced unbounded SlideSnapshotCache +
# SlideAssetCache dicts in userspace (one PIL RGBA per slide ~ 8MB
# at 1080p; with the 32-slide welcome reel they grow to ~512 MB
# total, which doesn't leave room for the EGL/GBM context). Lower-
# ing OPENMARQUEE_MAX_POOL_BUFFERS helped kernel memory but
# couldn't compensate for the userspace tier. Re-enable once the
# snapshot/asset caches grow LRU bounds (#TBD), or on Pis with
# enough RAM to absorb the unbounded growth.
# Environment="OPENMARQUEE_SHADER_TRANSITIONS=1"

# Bind to all interfaces on port 80 — the device is its own captive-portal
# WiFi so this is the primary UI.
ExecStart=/opt/openmarquee/venv/bin/uvicorn openmarquee.app:app \
    --host 0.0.0.0 --port 80

# Restart on crash; brief backoff to avoid hammering systemd if something
# is persistently wrong (config error, missing asset, etc).
Restart=on-failure
RestartSec=2s

# Let uvicorn bind to port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Sandbox the service a bit.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# /var/openmarquee is not a StateDirectory= target (that would create
# /var/lib/openmarquee); the install docs + Phase 9 image builder
# pre-create /var/openmarquee so `ReadWritePaths` has an existing dir
# to carve out of ProtectSystem=strict.
ReadWritePaths=/var/openmarquee

[Install]
WantedBy=multi-user.target
