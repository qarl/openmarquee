[Unit]
Description=openMarquee backend (FastAPI + playback loop)
Documentation=https://github.com/qarl/openmarquee

# Wait until the network stack is up. openmarquee-ap0.service creates
# the virtual `ap0` interface; hostapd.service hosts the AP on it;
# dnsmasq.service runs DHCP/DNS on it. All three should be settled
# before we bind to port 80 (uvicorn listens on 0.0.0.0 so it catches
# both ap0 and any station-mode wlan0 association — that's the remote-
# management surface Tailscale later reaches).
After=network-online.target openmarquee-ap0.service hostapd.service dnsmasq.service
Wants=network-online.target

# 19.1 / sweep #10 #3: cap the restart-on-failure loop so a wedged
# startup (config error, missing asset, lifespan exception) doesn't
# burn the SD card with a constant respawn. After 5 failures in 5
# minutes, systemd stops trying -- operator must intervene
# (journalctl -u openmarquee-backend + a manual `systemctl reset-
# failed && systemctl start openmarquee-backend` to retry).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=openmarquee
Group=openmarquee
WorkingDirectory=/opt/openmarquee/backend

# Content + playlist + schedule live under /var per Linux FHS (variable
# state). The systemd unit sets explicit paths so the app doesn't depend on
# cwd-relative defaults.
Environment="OPENMARQUEE_CONTENT_ROOT=/var/openmarquee/content"
Environment="OPENMARQUEE_UI_DIR=/opt/openmarquee/ui"
Environment="OPENMARQUEE_PLAYLIST_PATH=/var/openmarquee/playlist.json"
Environment="OPENMARQUEE_SCHEDULE_PATH=/var/openmarquee/schedules.json"
Environment="OPENMARQUEE_SETTINGS_PATH=/var/openmarquee/settings.json"
Environment="OPENMARQUEE_SEED_MARKER_PATH=/var/openmarquee/seeded.json"
Environment="OPENMARQUEE_DEV_PREVIEW_PATH=/var/openmarquee/preview.png"
# 19.3 / sweep #10 #6: flock + tombstone paths weren't explicit
# here; they fell back to dependencies.py's project-root-relative
# default. Make /var canonical so a future cwd change doesn't
# silently relocate flock.json / tombstones.json.
Environment="OPENMARQUEE_FLOCK_PATH=/var/openmarquee/flock.json"
Environment="OPENMARQUEE_TOMBSTONE_PATH=/var/openmarquee/tombstones.json"
# 20.1 / phase A.1: auth.json carries the argon2id password hash +
# token_version. 0600 owner-only by atomic_write_text. Recovery via
# physical SD access (delete the file + redo welcome flow per
# system/README.md).
Environment="OPENMARQUEE_AUTH_PATH=/var/openmarquee/auth.json"

# Production: strip the /dev tooling (preview page, manual play endpoint)
# from the HTTP surface. The gate is read by app.py at startup.
Environment="OPENMARQUEE_DISABLE_DEV=1"

# Use the multi-plane DRM/KMS renderer when output_mode=hdmi (per
# settings.json). Stress-tests the new rendering system end-to-end:
# bg + statics on the primary plane, animated layers on overlays,
# scanout via vc4 HVS instead of per-tick PIL composite. Falls back
# to MockRenderer at startup if DRM init fails (see app.py lifespan).
#
# Phase 7 slice 3 (2026-05-13): the Rust IPC sidecar is opt-in via
# OPENMARQUEE_RENDERER=rust-sidecar (flip the line below). Default
# stays `auto` per the Phase 7 migration plan -- operators opt in
# explicitly after slice-4 playback.py bypass + V4L2 video support
# both land. The binary lives at /usr/local/bin/openmarquee-render
# when install.sh has staged it; override with OPENMARQUEE_RENDERER_
# BINARY if you've put it elsewhere.
Environment="OPENMARQUEE_RENDERER=auto"
Environment="OPENMARQUEE_RENDERER_BINARY=/usr/local/bin/openmarquee-render"

# Perf-night r4 (2026-05-26): enable V4L2 DMABUF CAPTURE path so the
# renderer's bake_video_slide_to_current_fbo imports decoded frames
# via EGLImage zero-copy instead of CPU tex_image_2d upload of Y + UV
# planes. MMAP-mode upload was 24ms p50 on dev Pi (73% of 30fps
# budget); DMABUF eliminates the upload. video_decode.rs:105 gates on
# this var; missing → defaults to MMAP. EGL_EXT_image_dma_buf_import +
# GL_OES_EGL_image_external must be present at runtime (verified on
# dev Pi 2026-05-26; the renderer logs "DmaBuf EGLImage path disabled"
# at session start when either is missing).
Environment="OPENMARQUEE_RENDERER_DMABUF=1"

# Shader transitions still off on Pi Zero 2 W. Three rounds of
# fixes -- cycle-aware cache eviction (2026-05-06), pool 20->6,
# and glTexSubImage2D for same-dim re-uploads (dca94d5) -- each
# bought time but none made the box fit. Last retest 2026-05-05:
# 11 minutes shader-on, 4 OOM kills, cadence ~2-3 min. The hard
# constraint: CMA region is pinned at ~247/256 MB before the
# first transition (GBM dumb buffer pool dominates the kernel's
# GPU budget), and shader transitions need EGL backbuffers + 4x
# 1080p GL textures on top of that. 416 MB of physical RAM minus
# the CMA carveout doesn't leave room for both the welcome reel's
# slide-asset cache AND the shader's transient buffers. Re-enable
# on a Pi with >=1 GB physical RAM by uncommenting:
# Environment="OPENMARQUEE_SHADER_TRANSITIONS=1"

# Bind to all interfaces on port 80 — the device is its own captive-portal
# WiFi so this is the primary UI.
ExecStart=/opt/openmarquee/venv/bin/uvicorn openmarquee.app:app \
    --host 0.0.0.0 --port 80 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1

# Restart on crash; brief backoff to avoid hammering systemd if something
# is persistently wrong (config error, missing asset, etc).
Restart=on-failure
RestartSec=2s

# Let uvicorn bind to port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Sandbox the service a bit.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# 19.4 / sweep #10 #8 -- systemd hardening defaults. Safe to enable;
# none of these conflict with the FastAPI + DRM + Tailscale flow.
# MemoryDenyWriteExecute deliberately excluded: it would block the
# renderer's mmap+GL surfaces (CMA-backed dumb buffers + GLES2
# shader-program upload). Revisit after the renderer Rust rewrite
# settles.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AF_NETLINK is required by aiortc's aioice — its ICE candidate
# gather enumerates local interfaces via a netlink socket. Without
# this whitelist entry, /api/live/start crashes with
# `OSError: [Errno 97] Address family not supported by protocol`
# at the first `RTCPeerConnection.setLocalDescription(...)` call,
# the route catches it + sanitizes to a generic 400, and the Mode A
# (Live takeover) path silently fails. Diagnosed on FYS 2026-05-23
# via /tmp/aiortc-shakeout-fys.py + backend journal correlation.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
# /var/openmarquee is not a StateDirectory= target (that would create
# /var/lib/openmarquee); the install docs + Phase 9 image builder
# pre-create /var/openmarquee so `ReadWritePaths` has an existing dir
# to carve out of ProtectSystem=strict.
ReadWritePaths=/var/openmarquee

[Install]
WantedBy=multi-user.target
