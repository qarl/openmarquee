# /etc/sudoers.d/openmarquee — minimal NOPASSWD grants for the
# openmarquee service user.
#
# Installed by scripts/install.sh to /etc/sudoers.d/openmarquee with
# mode 0440 (per sudoers requirements). visudo-validated post-install.
#
# Scope: exactly two systemctl invocations needed for the wifi-station
# applier (`backend/openmarquee/wifi_station.py`). The applier runs in
# the backend's user context (not root) but needs to bounce
# `wpa_supplicant@wlan0` when operator-supplied home-WiFi creds change.
# Granting these two specific commands NOPASSWD is narrower than
# granting `systemctl` wildcards or running the whole backend as root.
#
# Anything beyond these two invocations should NOT be added here; new
# privileged operations should go through their own narrowly-scoped
# entries (one per command + arg shape).
#
# WARNING: do not edit this file in place on a deployed Pi. The install
# script overwrites it on every deploy. Make changes in the repo +
# redeploy.

openmarquee ALL=(root) NOPASSWD: /usr/bin/systemctl restart wpa_supplicant@wlan0
openmarquee ALL=(root) NOPASSWD: /usr/bin/systemctl stop wpa_supplicant@wlan0
