# /etc/sudoers.d/openmarquee — minimal NOPASSWD grants for the
# openmarquee service user.
#
# Installed by scripts/install.sh to /etc/sudoers.d/openmarquee with
# mode 0440 (per sudoers requirements). visudo-validated post-install.
#
# Scope: exactly two nmcli subcommands needed for the wifi-station
# applier (`backend/openmarquee/wifi_station.py`). The applier runs in
# the backend's user context (not root) but needs NM-level changes to
# create / activate / delete the wlan0 connection profile when the
# operator supplies home-WiFi creds.
#
# Read-only nmcli queries (`device status`, `connection show`,
# `device show wlan0`) run WITHOUT sudo — NM grants read access to
# users in the `netdev` group by default on Pi OS / Debian.
#
# Anything beyond these two invocations should NOT be added here;
# new privileged operations should go through their own narrowly-
# scoped entries (one per command + arg shape). Notably, `nmcli
# device disconnect` is INTENTIONALLY NOT GRANTED: it would free
# wlan0 entirely + could cascade into the AP's ap0 (shared radio).
# Use connection-level operations only.
#
# `nmcli device wifi rescan` (called pre-connect per 0575572)
# runs WITHOUT sudo — NM grants scan ops to users in the
# `netdev` group on Pi OS / Debian. No sudoers entry needed.
#
# WARNING: do not edit this file in place on a deployed Pi. The
# install script overwrites it on every deploy. Make changes in the
# repo + redeploy.

openmarquee ALL=(root) NOPASSWD: /usr/bin/nmcli device wifi connect *
openmarquee ALL=(root) NOPASSWD: /usr/bin/nmcli connection delete *

# P1.2-B.1 (2026-06-10): privileged network-control helper. The
# openMarquee backend runs under NoNewPrivileges=true +
# ProtectSystem=strict (system/openmarquee-backend.service), so it
# cannot write /etc/ nor restart system services directly. The
# helper at /usr/local/sbin/openmarquee-netctl is the privilege
# boundary; its subcommand allowlist + STDIN-only file content
# prevent argv injection. Subcommands documented in
# system/openmarquee-netctl.
#
# Scope must stay tight: any NEW privileged operation needs (a) a
# new subcommand in the helper and (b) an extension here. Do NOT
# relax this to a generic `openmarquee-netctl *` form.
openmarquee ALL=(root) NOPASSWD: /usr/local/sbin/openmarquee-netctl nm-write-unmanaged-wlan0
openmarquee ALL=(root) NOPASSWD: /usr/local/sbin/openmarquee-netctl nm-remove-unmanaged-wlan0
openmarquee ALL=(root) NOPASSWD: /usr/local/sbin/openmarquee-netctl nm-reload
openmarquee ALL=(root) NOPASSWD: /usr/local/sbin/openmarquee-netctl wpa-write-wlan0-conf
openmarquee ALL=(root) NOPASSWD: /usr/local/sbin/openmarquee-netctl wpa-enable-wlan0
openmarquee ALL=(root) NOPASSWD: /usr/local/sbin/openmarquee-netctl wpa-stop-wlan0
openmarquee ALL=(root) NOPASSWD: /usr/local/sbin/openmarquee-netctl hostapd-write-and-restart
