[Unit]
Description=openMarquee first-boot config (AP password rotation + welcome.html templating)
Documentation=https://github.com/qarl/openmarquee

# Run after the local filesystem is up but BEFORE the backend / AP
# services try to use the files we generate. wifi.json is read by
# the backend (settings.py reflects it into the UI). hostapd.conf
# is read by hostapd.service.
After=local-fs.target
Before=openmarquee-backend.service hostapd.service openmarquee-ap0.service

# Don't run if we've already bootstrapped. The script ALSO has its
# own idempotency check (wifi.json existence), but the systemd-level
# ConditionPathExists keeps the unit from even firing on subsequent
# boots -- cleaner journal log + faster boot.
ConditionPathExists=!/var/openmarquee/.bootstrapped

# Cap retries: if the script keeps crashing, stop trying so journalctl
# shows the cycle clearly. (Phase 4u: StartLimitIntervalSec and
# StartLimitBurst belong in [Unit], not [Service] — both keys are
# documented under [Unit] per `man systemd.unit`. Previously placed
# in [Service]; systemd spammed "Unknown key 'StartLimitIntervalSec'
# in section [Service], ignoring." once per boot per key.)
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
# RemainAfterExit=no: this is a fire-and-forget oneshot. Once it
# touches .bootstrapped and disables itself, it's done forever.
RemainAfterExit=no
ExecStart=/opt/openmarquee/system/openmarquee-firstboot.sh
# After successful run, disable so future boots skip the unit even
# without the ConditionPathExists guard (defense in depth).
ExecStartPost=/bin/systemctl disable openmarquee-firstboot.service

# Run as root: we mutate /etc/hostapd, /var/openmarquee, and
# /opt/openmarquee/ui. Tight FS access via the directives below
# restricts the blast radius; openmarquee-backend.service has a
# similar shape.
User=root
Group=root
# ProtectSystem=true (NOT =full): firstboot.sh templates /etc/hostname,
# /etc/hosts, /etc/hostapd via `sed -i` and `hostnamectl set-hostname`.
# ProtectSystem=full mounts /etc as a read-only bind-mount at the
# kernel namespace level — and that mount can't be cleanly overridden
# by ReadWritePaths in trixie's systemd (empirically verified in QA's
# Lima VM). ProtectSystem=true keeps /usr + /boot read-only (the
# genuinely-protective surface where binaries live) without touching
# /etc, so the templating succeeds. ProtectHome + PrivateTmp +
# NoNewPrivileges hardening unchanged. ReadWritePaths below stays as
# an explicit declaration of write intent for the maintainer reading
# this file — under ProtectSystem=true the entries are effectively
# documentation, not enforcement.
ProtectSystem=true
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/etc /opt/openmarquee/ui /var/openmarquee
# Restart only on failure -- a clean exit means we're done. The
# accompanying retry cap (StartLimitIntervalSec + StartLimitBurst)
# lives in [Unit] above — per systemd docs those keys belong there,
# not in [Service].
Restart=on-failure

[Install]
WantedBy=multi-user.target
