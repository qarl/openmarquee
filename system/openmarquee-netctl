#!/usr/bin/env bash
# openMarquee privileged network control helper.
#
# Invoked via `sudo -n /usr/local/sbin/openmarquee-netctl <command> [args]`
# by the openmarquee backend. The backend runs under
# NoNewPrivileges=true + ProtectSystem=strict, so it cannot write
# /etc directly nor restart system services; this helper crosses
# the privilege boundary.
#
# STRICT ARGV CONTRACT — this script is a privilege boundary. Every
# command + arg is validated; arbitrary shell interpolation is
# refused. File content for write-* commands comes from STDIN, never
# from argv, to prevent argv-injection of attacker-controlled file
# bytes.
#
# Sudoers grant lives in /etc/sudoers.d/openmarquee (system/
# openmarquee-sudoers in the repo) — keep the two in lock-step.
#
# Audit: every operation must be safe to invoke arbitrarily because
# the sudoers grant uses NOPASSWD. Side effects are restricted to:
#   * /etc/NetworkManager/conf.d/openmarquee-wlan0-unmanaged.conf
#   * /etc/wpa_supplicant/wpa_supplicant-wlan0.conf
#   * /etc/hostapd/hostapd.conf
#   * systemctl reload/restart/enable/stop on a fixed set of units
# A future operator who wants new privileged operations should add
# a new subcommand here + extend the sudoers grant; do not generalise
# this helper to take arbitrary paths.

set -euo pipefail

# Pinned paths. Hand-edit MUST update both the helper + the
# sudoers + the Python takeover module's docs in lock-step.
NM_DROP_IN="/etc/NetworkManager/conf.d/openmarquee-wlan0-unmanaged.conf"
WPA_CONF="/etc/wpa_supplicant/wpa_supplicant-wlan0.conf"
HOSTAPD_CONF="/etc/hostapd/hostapd.conf"
WIFI_POWERSAVE_OFF_SCRIPT="/opt/openmarquee/system/openmarquee-wifi-powersave-off.sh"

usage() {
    cat >&2 <<EOF
usage: openmarquee-netctl <command> [args...]

P1.2-B network take-over commands (read content from stdin where applicable):
    nm-write-unmanaged-wlan0       Write NM unmanaged drop-in for wlan0
                                   (file content via STDIN)
    nm-remove-unmanaged-wlan0      Delete the NM unmanaged drop-in
    nm-reload                      systemctl reload NetworkManager
    nm-supplicant-stop             systemctl stop wpa_supplicant.service
                                   (P1.2-B.3: release NM's singleton wpa_supplicant's
                                    hold on wlan0 BEFORE enabling our own
                                    wpa_supplicant@wlan0.service)
    nm-supplicant-start            systemctl start wpa_supplicant.service
                                   (rollback companion to nm-supplicant-stop)
    wpa-write-wlan0-conf           Write wpa_supplicant-wlan0.conf
                                   (file content via STDIN; mode 0600)
    wpa-enable-wlan0               systemctl enable --now wpa_supplicant@wlan0.service
    wpa-stop-wlan0                 systemctl stop wpa_supplicant@wlan0.service
    hostapd-write-and-restart      Write hostapd.conf (STDIN) + systemctl restart hostapd
    hostapd-stop                   systemctl stop hostapd.service
                                   (P2: supervisor tears down the AP on
                                    LINGER->ONLINE per spec §"Onboarding
                                    state machine" — concurrent 24/7 is
                                    the fragile mode that produces the
                                    intermittent failures the spec is
                                    trying to fix.)
    hostapd-start                  systemctl start hostapd.service
                                   (P2: supervisor re-ups the AP on
                                    ONLINE->DEGRADED so the recovery
                                    path is always available, and on
                                    ONLINE->SETUP for operator-driven
                                    re-entry.)
    wifi-powersave-off             Re-run openmarquee-wifi-powersave-off.sh
                                   (P1.3: supervisor fires this on every
                                    STA reassociation per spec §A#2 —
                                    brcmfmac resets power_save on reassoc.
                                    No payload; the script is idempotent.)

If you need a new privileged operation, add a new subcommand here
AND extend system/openmarquee-netctl-daemon's ALLOWLIST.
EOF
    exit 64  # EX_USAGE
}

# Atomic file install: read stdin into a same-FS tempfile + os.replace.
# Atomic IFF the temp + target are on the same filesystem (sibling).
install_from_stdin() {
    local target="$1"
    local mode="$2"
    local dir
    dir=$(dirname "$target")
    mkdir -p "$dir"
    local tmp
    tmp=$(mktemp -p "$dir" ".openmarquee-netctl.XXXXXX")
    # On any failure, remove the tempfile.
    trap 'rm -f "$tmp"' RETURN
    # Read all of stdin into the tempfile.
    cat > "$tmp"
    chmod "$mode" "$tmp"
    chown root:root "$tmp"
    mv -f "$tmp" "$target"
    trap - RETURN
}

cmd="${1:-}"

case "$cmd" in
    nm-write-unmanaged-wlan0)
        [ $# -eq 1 ] || usage
        install_from_stdin "$NM_DROP_IN" 0644
        ;;
    nm-remove-unmanaged-wlan0)
        [ $# -eq 1 ] || usage
        rm -f "$NM_DROP_IN"
        ;;
    nm-reload)
        [ $# -eq 1 ] || usage
        systemctl reload NetworkManager
        ;;
    nm-supplicant-stop)
        # P1.2-B.3: stop NM's singleton wpa_supplicant.service so
        # our wpa_supplicant@wlan0.service can claim the wlan0
        # interface (NM's supplicant doesn't release wlan0 on
        # `nmcli unmanaged` — it keeps holding the nl80211 ifname
        # which makes our instance fail status=255
        # "another wpa_supplicant process already running"). On
        # this device NM's supplicant only serves wlan0; ap0 is
        # hostapd-driven, so stopping it is safe.
        [ $# -eq 1 ] || usage
        systemctl stop wpa_supplicant.service
        ;;
    nm-supplicant-start)
        # Rollback companion to nm-supplicant-stop. Brings NM's
        # singleton back so NetworkManager can resume managing
        # wlan0 after the rollback.
        [ $# -eq 1 ] || usage
        systemctl start wpa_supplicant.service
        ;;
    wpa-write-wlan0-conf)
        [ $# -eq 1 ] || usage
        install_from_stdin "$WPA_CONF" 0600
        ;;
    wpa-enable-wlan0)
        [ $# -eq 1 ] || usage
        systemctl enable --now wpa_supplicant@wlan0.service
        ;;
    wpa-stop-wlan0)
        [ $# -eq 1 ] || usage
        systemctl stop wpa_supplicant@wlan0.service
        ;;
    hostapd-write-and-restart)
        [ $# -eq 1 ] || usage
        install_from_stdin "$HOSTAPD_CONF" 0644
        systemctl restart hostapd.service
        ;;
    hostapd-stop)
        # P2 (2026-06-27): supervisor's AP-teardown actuator fires
        # this on LINGER->ONLINE per spec §"Onboarding state
        # machine" — the canonical steady state is STA-only with
        # AP off ("the setup network is a temporary door, not a
        # permanent feature"). The AP re-ups on STA loss
        # (ONLINE->DEGRADED) so the recovery path is always
        # available.
        [ $# -eq 1 ] || usage
        systemctl stop hostapd.service
        ;;
    hostapd-start)
        # P2 (2026-06-27): supervisor's AP re-up actuator fires
        # this on ONLINE->DEGRADED + ONLINE->SETUP. Companion to
        # hostapd-stop; reuses the existing hostapd.conf on disk
        # (no rewrite — channel-follow happens separately via
        # hostapd-write-and-restart).
        [ $# -eq 1 ] || usage
        systemctl start hostapd.service
        ;;
    # ---------------------------------------------------------
    # 2026-07-03 (qarl handover Phase B1): privileged wifi
    # networks + device-name propagation subcommands. The
    # backend (User=openmarquee, NoNewPrivileges=true) cannot
    # invoke nmcli / hostnamectl / tailscale / systemctl directly
    # — those all fail-soft to no-ops. These subcommands are the
    # sanctioned crossings.
    # ---------------------------------------------------------
    nm-connection-add-wifi)
        # Payload (stdin): 5 lines in this exact order —
        #   con_name\n
        #   ssid\n
        #   password\n   (empty line for no PSK)
        #   autoconnect  (yes|no)\n
        #   priority     (integer)\n
        # nmcli's argv contract accepts each as a stable connection
        # setting; ssid + password come via argv (never stdin) so
        # nmcli's argument-quoting handles them without shell
        # interpolation on our end.
        [ $# -eq 1 ] || usage
        IFS=$'\n' read -r con_name || true
        IFS=$'\n' read -r ssid || true
        IFS=$'\n' read -r password || true
        IFS=$'\n' read -r autoconnect || true
        IFS=$'\n' read -r priority || true
        [ -n "$con_name" ] || { echo "missing con_name" >&2; exit 2; }
        [ -n "$ssid" ] || { echo "missing ssid" >&2; exit 2; }
        # Priority parsing check (defensive — the backend already
        # clamps this via Pydantic, but this is a privilege
        # boundary).
        [[ "$priority" =~ ^-?[0-9]{1,3}$ ]] || {
            echo "invalid priority" >&2; exit 2;
        }
        nmcli connection add type wifi con-name "$con_name" ssid "$ssid" \
            connection.autoconnect "$autoconnect" \
            connection.autoconnect-priority "$priority"
        if [ -n "$password" ]; then
            nmcli connection modify "$con_name" \
                wifi-sec.key-mgmt wpa-psk \
                wifi-sec.psk "$password"
        fi
        ;;
    nm-connection-modify-wifi)
        # Same payload shape as nm-connection-add-wifi.
        # Skips the key-mgmt / psk update when password is empty
        # (preserves WPA3-SAE profiles per QA LOW note).
        [ $# -eq 1 ] || usage
        IFS=$'\n' read -r con_name || true
        IFS=$'\n' read -r ssid || true
        IFS=$'\n' read -r password || true
        IFS=$'\n' read -r autoconnect || true
        IFS=$'\n' read -r priority || true
        [ -n "$con_name" ] || { echo "missing con_name" >&2; exit 2; }
        [ -n "$ssid" ] || { echo "missing ssid" >&2; exit 2; }
        [[ "$priority" =~ ^-?[0-9]{1,3}$ ]] || {
            echo "invalid priority" >&2; exit 2;
        }
        nmcli connection modify "$con_name" \
            802-11-wireless.ssid "$ssid" \
            connection.autoconnect "$autoconnect" \
            connection.autoconnect-priority "$priority"
        if [ -n "$password" ]; then
            nmcli connection modify "$con_name" \
                wifi-sec.key-mgmt wpa-psk \
                wifi-sec.psk "$password"
        fi
        ;;
    nm-connection-delete)
        # Payload (stdin): one line, the connection name to delete.
        # Ownership + activated-state checks live in the Python
        # actuator BEFORE the send — this is a raw privilege
        # crossing.
        [ $# -eq 1 ] || usage
        IFS=$'\n' read -r con_name || true
        [ -n "$con_name" ] || { echo "missing con_name" >&2; exit 2; }
        nmcli connection delete "$con_name"
        ;;
    hostnamectl-set-hostname)
        # Payload (stdin): one line, the new hostname.
        # The backend has already normalised to DNS-safe chars via
        # the sign_name field validator; hostnamectl also refuses
        # obvious garbage, but the pre-normalisation is what
        # guarantees the four consumers agree.
        [ $# -eq 1 ] || usage
        IFS=$'\n' read -r name || true
        [ -n "$name" ] || { echo "missing name" >&2; exit 2; }
        hostnamectl set-hostname "$name"
        ;;
    tailscale-set-hostname)
        # Payload (stdin): one line, the new tailnet hostname.
        [ $# -eq 1 ] || usage
        IFS=$'\n' read -r name || true
        [ -n "$name" ] || { echo "missing name" >&2; exit 2; }
        tailscale set --hostname "$name"
        ;;
    avahi-write-and-restart)
        # Payload (stdin): full avahi-daemon.conf content. Written
        # atomically at /etc/avahi/avahi-daemon.conf then
        # systemctl restart avahi-daemon. Same shape as the
        # existing hostapd-write-and-restart above.
        [ $# -eq 1 ] || usage
        install_from_stdin /etc/avahi/avahi-daemon.conf 0644
        systemctl restart avahi-daemon
        ;;
    wifi-powersave-off)
        # P1.3 (2026-06-27): re-fire the boot-oneshot power-save
        # logic on every STA reassociation. brcmfmac resets
        # power_save when a reassociation happens, so the supervisor
        # fires this on every STA_ASSOCIATED event (spec §A#2 —
        # "It can be reset by reassociation. Make this a boot-time
        # service, not a one-off."). Re-uses the already-shipped
        # /opt/openmarquee/system/openmarquee-wifi-powersave-off.sh
        # verbatim so iface coverage + logger tag stay in lock-step
        # with the boot oneshot.
        [ $# -eq 1 ] || usage
        "$WIFI_POWERSAVE_OFF_SCRIPT"
        ;;
    *)
        usage
        ;;
esac
